      "type" : "org.thingsboard.rule.engine.metadata.TbGetAttributesNode"
    }, {
      "additionalInfo" : {
        "description" : "",
        "layoutX" : 1165,
        "layoutY" : 172
      },
      "configuration" : {
        "scriptLang" : "JS",
        "jsScript" : "var voltage = Number(msg.voltage);\r\nvar current = Number(msg.current);\r\nvar ratedPowerKva = Number(msg.ss_ratedPowerKva);\r\n\r\nif (!isFinite(voltage) ||\r\n    !isFinite(current) ||\r\n    !isFinite(ratedPowerKva) ||\r\n    ratedPowerKva <= 0) {\r\n    throw new Error(\r\n        \"Missing or invalid voltage, current, or ratedPowerKva\"\r\n    );\r\n}\r\n\r\nvar apparentPowerKva =\r\n    (voltage * current) / 1000;\r\n\r\nvar loadPercent =\r\n    (apparentPowerKva / ratedPowerKva) * 100;\r\n\r\nmsg.apparentPowerKva =\r\n    Number(apparentPowerKva.toFixed(3));\r\n\r\nmsg.loadPercent =\r\n    Number(loadPercent.toFixed(2));\r\n\r\nreturn {\r\n    msg: msg,\r\n    metadata: metadata,\r\n    msgType: \"POST_TELEMETRY_REQUEST\"\r\n};",
        "tbelScript" : "return {msg: msg, metadata: metadata, msgType: msgType};ratedPowerKva"
      },
