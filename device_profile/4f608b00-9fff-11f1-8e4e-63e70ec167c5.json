      "expression" : "function calculate(ctx, fuelVolumeL) {\r\n\r\n    var values = fuelVolumeL.values;\r\n\r\n    if (values == null || values.size() < 2) {\r\n        return null;\r\n    }\r\n\r\n    var first = values.get(0).value;\r\n    var last = values.get(values.size() - 1).value;\r\n\r\n    if (first == null || last == null) {\r\n        return null;\r\n    }\r\n\r\n    var fuelDrop = first - last;\r\n\r\n    if (fuelDrop <= 0) {\r\n        fuelDrop = 0;\r\n    }\r\n\r\n    return {\r\n        \"ts\": ctx.latestTs,\r\n        \"values\": {\r\n            \"fuelDropL\": toFixed(fuelDrop, 3)\r\n        }\r\n    };\r\n}",
